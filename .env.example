# ---- Service ----------------------------------------------------------------
# Shared secret; api-core sends it as "Authorization: Bearer <token>".
# Generate: openssl rand -hex 32  (same value as MAIL_ROUTER_TOKEN in api-core's .env)
MAIL_ROUTER_TOKEN=
# api-core's Docker network (docker network ls | grep api-core-network):
#   hoanxu.com     -> affiliate_core_api-core-network
#   hoantien.work  -> affilate-core_api-core-network
CORE_NETWORK=
# Host port bound to 127.0.0.1 for local checks.
MAIL_ROUTER_HOST_PORT=8090
# Max time for one message through every provider; api-core's
# MAIL_ROUTER_TIMEOUT must be longer.
MAIL_ROUTER_SEND_TIMEOUT=60s
# How long a sent idempotency key is remembered (in memory).
MAIL_ROUTER_IDEMPOTENCY_TTL=24h

# ---- Sender (used when a request has no "from") ----------------------------
EMAIL_FROM_NAME=Hoàn Xu
EMAIL_FROM_ADDRESS=

# ---- Providers ---------------------------------------------------------------
# smtp (default) | resend | brevo | sendgrid | ses | log | noop
# Several providers, each with an optional weight: brevo:3,sendgrid:1,resend:1
EMAIL_PROVIDER=smtp
# failover (default): always start with the first provider, move on when it is
# rate limited, over quota or unreachable. round_robin: spread mail by weight.
EMAIL_ROUTING=failover
# Providers used only after every EMAIL_PROVIDER failed, in order. Optional.
EMAIL_PROVIDER_FALLBACK=
# How long a provider that reported "quota exceeded" is skipped.
EMAIL_PROVIDER_COOLDOWN=30m
# Optional in-process retry per provider (api-core's consumers/outbox retry too).
EMAIL_RETRY_ATTEMPTS=1
EMAIL_RETRY_DELAY=500ms
EMAIL_RATE_LIMIT_PER_SECOND=0

# EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.privateemail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TEXT_PART=false

# EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
RESEND_TIMEOUT=15s
RESEND_IDEMPOTENCY=true

# EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com
BREVO_TIMEOUT=15s
BREVO_IDEMPOTENCY=true

# EMAIL_PROVIDER=sendgrid (EU-pinned subuser: https://api.eu.sendgrid.com)
SENDGRID_API_KEY=
SENDGRID_API_URL=https://api.sendgrid.com
SENDGRID_TIMEOUT=15s

# EMAIL_PROVIDER=ses (credentials from the standard AWS chain)
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SES_REGION=
SES_CONFIGURATION_SET=
